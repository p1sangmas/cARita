name = "your-project-name"
pages_build_output_dir = "."
compatibility_date = "2024-01-01"

[[r2_buckets]]
binding = "R2"
bucket_name = "your-r2-bucket-name"   

# After running: wrangler kv:namespace create your-kv-name
# replace the id below with the output namespace ID
[[kv_namespaces]]
binding = "KV"
id = "your-kv-namespace-id"           
